# Copy to .env for variable substitution in compose (do not commit .env).
# Local run: docker compose -f docker-compose.yml -f docker-compose.local.yml up --build
#
# Timeweb Apps (optional CORS):
# APP_PUBLIC_URL=https://your-app.twc1.net

# --- Timeweb S3 (Object Storage) ---
ENABLE_BACKUPS=false
ENABLE_AUTO_RESTORE=true
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL=https://s3.twcstorage.ru
AWS_REGION=ru-1
AWS_S3_PREFIX=agentmemory-backups
BACKUP_KEEP_COUNT=7

# --- Optional LLM / embeddings (agentmemory runs without these in BM25-only mode) ---
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# AGENTMEMORY_AUTO_COMPRESS=true
# AGENTMEMORY_INJECT_CONTEXT=true

# AGENTMEMORY_SECRET is generated on first boot into /data/.hmac — do not set here for production.
